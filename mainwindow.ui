  <property name="styleSheet">
   <string notr="true">
*{
	font: 700 10pt &quot;Consolas&quot;;
	color: #06141B;
	background-color: #22323A;
}
QWidget{
	border-radius: 0px;
}
QQuickWidget{
	background: transparent;
	border: none;
	border-radius: 0px;
}
QStackedWidget{
	background-color: #9BA8AB;
	border: 1px solid #74858A;
	border-radius: 8px;
}
QPushButton{
	border-radius: 6px;
	color: #FFFFFF;
	background-color: #4A5C6A;
	border: 1px solid #6F818C;
	padding: 6px 10px;
}
QPushButton:hover{
	background-color: #5F7481;
	border-color: #DDE5E7;
}
QPushButton:pressed {
	color: #06141B;
	background-color: #DCE1E1;
	border: 1px solid #4A5C6A;
}
QPushButton:disabled {
	color: #7B8789;
	background-color: #B6BFC1;
	border-color: #9BA8AB;
}
QPushButton#Home_pushButton,
QPushButton#Ejecucion_pushButton,
QPushButton#ScreenCalibrar_pushbutton,
QPushButton#SistemasDeControl_pushButton {
	background-color: #06141B;
	border: 1px solid #4A5C6A;
	border-radius: 8px;
	padding: 8px;
}
QPushButton#Home_pushButton:hover,
QPushButton#Ejecucion_pushButton:hover,
QPushButton#ScreenCalibrar_pushbutton:hover,
QPushButton#SistemasDeControl_pushButton:hover {
	background-color: #4A5C6A;
}
QLineEdit, QSpinBox, QDoubleSpinBox{
	color: #06141B;
	background-color: #E4E8E7;
	border: 1px solid #7E8D91;
	border-radius: 5px;
	padding: 4px 6px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus{
	border: 1px solid #4A5C6A;
	background-color: #F1F4F3;
}
QTextEdit{
	color: #06141B;
	background-color: #E4E8E7;
	border: 1px solid #7E8D91;
	border-radius: 5px;
	padding: 4px;
}
QLabel{
	display: inline-block;
	color: #E8ECEC;
	background-color: #06141B;
	border: 1px solid #22323A;
	border-radius: 5px;
	padding: 3px 6px;
	text-align: center;
}
QLabel#TPCCONECTED, QLabel#TPCCONECTED_2{
	color: #E8ECEC;
	background-color: rgb(85, 0, 0);
	border-radius: 13px;
	border: 1px solid #CCD0CF;
	text-align: center;
}
QLabel#MODO_LABEL,
QLabel#label_11,
QLabel#WifiPortLabel_2 {
	background-color: #22323A;
	color: #E8ECEC;
	border: 1px solid #4A5C6A;
	border-radius: 6px;
}
QComboBox{
	color: #06141B;
	background-color: #E4E8E7;
	border: 1px solid #7E8D91;
	border-radius: 5px;
	padding: 4px 6px;
}
/* Esto aplica a todas las QProgressBar del proyecto */
QProgressBar {
    border: 1px solid #4A5C6A;
    border-radius: 5px;
    background-color: #06141B;
    text-align: center;
    color: #00FF7F; /* Color del texto */
    font-family: &quot;Consolas&quot;; /* Fuente técnica */
    font-weight: bold;
}

/* Estilo para la parte que se llena (Horizontal) */
QProgressBar::chunk:horizontal {
    background-color: #DDE5E7;
    border-radius: 4px;
}

/* Estilo para la parte que se llena (Vertical) */
QProgressBar::chunk:vertical {
    background-color: #DDE5E7;
    border-radius: 4px;
}
</string>
